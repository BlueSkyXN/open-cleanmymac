{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openclean:schema:finding:v1",
  "title": "Finding",
  "description": "某条 Strategy 在当前机器上的实际命中（AR-01 §5）。finding_id 不构成授权；类型化 evidence 承载差异。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "run_id",
    "strategy_id",
    "strategy_version",
    "target",
    "measurement",
    "assessment",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^finding:(?!redacted$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run:(?!redacted$)[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "strategy_id": {
      "type": "string"
    },
    "strategy_version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "display_path",
        "identifier",
        "identity"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "filesystem 可动作；filesystem_subset 为聚合根，永不动作"
        },
        "display_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": "string"
        },
        "identity": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "device": {
              "type": "integer"
            },
            "inode": {
              "type": "integer"
            },
            "owner": {
              "type": "integer"
            }
          },
          "required": [
            "device",
            "inode",
            "owner"
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "allocated_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "logical_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "age_days": {
          "type": [
            "integer",
            "null"
          ]
        },
        "latest_mtime": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "size",
        "allocated_bytes",
        "logical_bytes",
        "age_days",
        "latest_mtime"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "certainty",
        "action_risk",
        "actionable",
        "block_reasons",
        "requires_privilege",
        "is_cloud_file",
        "requires_explicit_selection"
      ],
      "properties": {
        "classification": {
          "enum": [
            "cleanup_candidate",
            "report_only",
            "protected"
          ]
        },
        "certainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "action_risk": {
          "type": "string",
          "enum": [
            "safe",
            "confirm",
            "critical"
          ]
        },
        "actionable": {
          "type": "boolean"
        },
        "block_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_privilege": {
          "type": "boolean"
        },
        "is_cloud_file": {
          "type": "boolean"
        },
        "requires_explicit_selection": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "payload"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "do_not_do": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary",
        "do_not_do"
      ]
    }
  }
}
