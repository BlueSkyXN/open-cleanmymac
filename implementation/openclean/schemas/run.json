{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openclean:schema:run:v1",
  "title": "Run",
  "description": "固化一次 inspect 的环境、策略版本与 finding_ids（AR-01 §4）。存于本机私有 Run Store；created_at/expires_at 为 epoch 秒。",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "created_at", "expires_at", "requested_target", "openclean_version"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run:"},
    "created_at": {"type": "number"},
    "expires_at": {"type": "number"},
    "requested_target": {"type": "string"},
    "openclean_version": {"type": "string"},
    "macos_version": {"type": "string"},
    "strategy_pack_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "protect_config_hash": {"type": "string"},
    "complete": {"type": "boolean"},
    "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "blocking": {"type": "boolean"}}}},
    "finding_ids": {"type": "array", "items": {"type": "string", "pattern": "^finding:"}}
  }
}
